PORT=3000
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=forum_db
DB_CONNECTION_LIMIT=10

# Aiven requires TLS. Download ca.pem from the Aiven service overview.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CA_PATH=./ca.pem

# Set DB_DRIVER=d1 after data has been migrated to Cloudflare D1.
DB_DRIVER=mysql
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Set DB_DRIVER=d1 after data has been migrated to Cloudflare D1.
DB_DRIVER=mysql
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudinary will be configured in step 5.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
